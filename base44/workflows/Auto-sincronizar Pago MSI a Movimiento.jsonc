{
  "name": "Auto-sincronizar Pago MSI a Movimiento",
  "description": "Al crear un pago MSI, intenta crear autom\u00e1ticamente una Transaction vinculada si hay category_id y person_id disponibles\"",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "MSIPayment"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_sincronizar_pago_msi_a_movimiento",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "createTransactionFromMSIPayment",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "createTransactionFromMSIPayment"
  }
}