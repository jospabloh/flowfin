    },
    {
      "function_name": "finiaAnalyzeSpending",
      "description": "Analiza el comportamiento de gasto: top categor\u00edas, tendencias mensuales, gastos inusuales y sugerencias. Par\u00e1metro opcional: months (1-3, default 2)."
    }
  ],
