    },
    {
      "function_name": "finiaGetUpcomingPayments",
      "description": "Obtiene los pagos programados pr\u00f3ximos (siguientes 30 d\u00edas) de la familia del usuario. Incluye fecha, monto, descripci\u00f3n y estado."
    },
    {
      "function_name": "finiaGetBudgetStatus",
      "description": "Obtiene el estado del presupuesto del mes actual: categor\u00edas cerca del l\u00edmite, categor\u00edas sobre el l\u00edmite y alertas."
    },
    {
      "function_name": "finiaAnalyzeSpending",
      "description": "Analiza el comportamiento de gasto: top categor\u00edas, tendencias, gastos inusuales, posibles pagos recurrentes perdidos. Par\u00e1metro opcional: months (1-3, default 2)."
    },
    {
      "function_name": "agentGetCatalogs",
      "description": "Alternativa para obtener cat\u00e1logos (personas, categor\u00edas, subcategor\u00edas, m\u00e9todos de pago). Resuelve la familia desde la sesi\u00f3n autenticada. NO requiere argumentos."
    },
    {
      "function_name": "agentCreateTransaction",
      "description": "Crea una transacci\u00f3n. SOLO usar despu\u00e9s de confirmaci\u00f3n expl\u00edcita del usuario. Par\u00e1metros: { amount, type, date, description?, category_id, person_id?, subcategory_id?, payment_method_id? }. Seguro: resuelve family_id desde sesi\u00f3n."
    }
  ],
  "whatsapp_greeting": "\u00a1Hola! Soy Finia \ud83d\udc9a, tu copiloto financiero de FlowFin. Puedo ayudarte a registrar gastos, revisar tus finanzas, detectar posibles errores y darte sugerencias para cuidar mejor el dinero de tu familia. \u00bfEn qu\u00e9 te ayudo hoy?",
  "telegram_greeting": "\u00a1Hola! Soy Finia \ud83d\udc9a, tu copiloto financiero de FlowFin. \u00bfEn qu\u00e9 te ayudo hoy?",
  "model": "automatic",
