      "description": "Detecta posibles duplicados antes de guardar. Par\u00e1metros: { amount: number, date: string, description?: string, category_id?: string, payment_method_id?: string }. Retorna hasPossibleDuplicate y detalles."
    },
    {
      "function_name": "finiaConfirmTransaction",
