{
  "name": "Subcategory",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia propietaria"
    },
    "name": {
      "type": "string",
      "description": "Nombre del subrubro"
    },
    "category_id": {
      "type": "string",
      "description": "ID de la categoría padre"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Palabras clave para autodetección"
    },
    "usage_count": {
      "type": "number",
      "default": 0,
      "description": "Conteo de uso para ordenar sugerencias"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    }
  }
}
