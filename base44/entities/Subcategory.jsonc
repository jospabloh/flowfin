{
  "name": "Subcategory",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia propietaria"
    },
    "name": {
      "type": "string",
      "description": "Nombre del subrubro"
    },
    "category_id": {
      "type": "string",
      "description": "ID de la categor\u00eda padre"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Palabras clave para autodetecci\u00f3n"
    },
    "usage_count": {
      "type": "number",
      "default": 0,
      "description": "Conteo de uso para ordenar sugerencias"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}