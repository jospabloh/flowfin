{
  "name": "SupportTicket",
  "type": "object",
  "description": "Ticket de soporte que una familia (tenant) abre a la plataforma. Los mensajes del hilo viven en SupportTicketMessage.",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia que abri\u00f3 el ticket"
    },
    "family_name": {
      "type": "string",
      "description": "Nombre de la familia (denormalizado)"
    },
    "subject": {
      "type": "string",
      "description": "Asunto del ticket"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n inicial del problema"
    },
    "category": {
      "type": "string",
      "enum": [
        "billing",
        "technical",
        "account",
        "feature_request",
        "other"
      ],
      "default": "other",
      "description": "Categor\u00eda"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal",
      "description": "Prioridad"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "waiting_customer",
        "resolved",
        "closed"
      ],
      "default": "open",
      "description": "Estado del ticket"
    },
    "created_by_id": {
      "type": "string",
      "description": "ID del usuario que lo cre\u00f3"
    },
    "created_by_email": {
      "type": "string",
      "description": "Email del creador"
    },
    "assigned_to": {
      "type": "string",
      "description": "Email del agente de soporte asignado (owner)"
    },
    "first_response_at": {
      "type": "string",
      "format": "date-time",
      "description": "Primera respuesta del soporte"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Cu\u00e1ndo se resolvi\u00f3"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Cu\u00e1ndo se cerr\u00f3"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltimo mensaje en el hilo"
    },
    "last_message_by_role": {
      "type": "string",
      "enum": [
        "owner",
        "tenant"
      ],
      "description": "Qui\u00e9n envi\u00f3 el \u00faltimo mensaje"
    },
    "messages_count": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de mensajes en el hilo"
    },
    "unread_for_owner": {
      "type": "boolean",
      "default": true,
      "description": "Hay mensajes sin leer para el soporte"
    },
    "unread_for_tenant": {
      "type": "boolean",
      "default": false,
      "description": "Hay mensajes sin leer para la familia"
    },
    "metadata": {
      "type": "object",
      "description": "Datos adicionales"
    },
    "ai_brief": {
      "type": "object",
      "description": "Brief estructurado generado por el asistente BA/PO cuando el ticket es de tipo nueva funcionalidad (feature) o incidencia (bug): historia de usuario, criterios de aceptaci\u00f3n, alcance, pasos de reproducci\u00f3n, severidad, impacto, etc. Aditivo: el mismo contenido tambi\u00e9n viaja en Markdown dentro de description."
    }
  },
  "required": [
    "family_id",
    "subject"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}