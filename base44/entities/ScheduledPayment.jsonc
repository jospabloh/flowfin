{
  "name": "ScheduledPayment",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia"
    },
    "name": {
      "type": "string",
      "description": "Nombre del pago (ej: Luz, Teléfono, Colegiatura)"
    },
    "description": {
      "type": "string",
      "description": "Descripción adicional"
    },
    "amount": {
      "type": "number",
      "description": "Monto estimado del pago"
    },
    "due_day": {
      "type": "number",
      "description": "Día del mes en que vence (1-28)"
    },
    "category_id": {
      "type": "string",
      "description": "ID de la categoría"
    },
    "payment_method_id": {
      "type": "string",
      "description": "Forma de pago habitual"
    },
    "person_id": {
      "type": "string",
      "description": "Persona responsable del pago (opcional, se usa al auto-postear)"
    },
    "type": {
      "type": "string",
      "enum": [
        "expense",
        "income"
      ],
      "default": "expense",
      "description": "Tipo de movimiento programado: egreso (domiciliado/pago) o ingreso (cobro recurrente, nómina)"
    },
    "icon": {
      "type": "string",
      "description": "Emoji representativo",
      "default": "💰"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "automation_mode": {
      "type": "string",
      "enum": [
        "manual",
        "auto"
      ],
      "default": "manual",
      "description": "manual = el usuario marca como pagado; auto = el sistema lo registra automáticamente cerca del día de vencimiento"
    },
    "autopost_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Habilita el autopost diario para este movimiento (sólo si automation_mode='auto')"
    },
    "autopost_day_tolerance": {
      "type": "number",
      "default": 0,
      "description": "Días de anticipación tolerados respecto al due_day para hacer el autopost (0-3)"
    },
    "match_hint": {
      "type": "string",
      "description": "Texto auxiliar para conciliación posterior con extractos bancarios"
    },
    "paused_until": {
      "type": "string",
      "description": "Pausado hasta este mes (YYYY-MM) o fecha (YYYY-MM-DD) — mientras no haya pasado, el pago no cuenta como pendiente/vencido"
    },
    "pause_reason": {
      "type": "string",
      "description": "Motivo de la pausa (ej: Pausa 1 mes, vacaciones, etc.)"
    },
    "audit_events": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Historial de acciones sobre este pago (pausar, reanudar, etc.): { action, at, by, by_user_id, reason }"
    }
  },
  "required": [
    "family_id",
    "name",
    "due_day"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    }
  }
}
