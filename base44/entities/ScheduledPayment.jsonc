{
  "name": "ScheduledPayment",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia"
    },
    "name": {
      "type": "string",
      "description": "Nombre del pago (ej: Luz, Tel\u00e9fono, Colegiatura)"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n adicional"
    },
    "amount": {
      "type": "number",
      "description": "Monto estimado del pago"
    },
    "due_day": {
      "type": "number",
      "description": "D\u00eda del mes en que vence (1-28)"
    },
    "category_id": {
      "type": "string",
      "description": "ID de la categor\u00eda"
    },
    "payment_method_id": {
      "type": "string",
      "description": "Forma de pago habitual"
    },
    "person_id": {
      "type": "string",
      "description": "Persona responsable del pago (opcional, se usa al auto-postear)"
    },
    "type": {
      "type": "string",
      "enum": [
        "expense",
        "income"
      ],
      "default": "expense",
      "description": "Tipo de movimiento programado: egreso (domiciliado/pago) o ingreso (cobro recurrente, n\u00f3mina)"
    },
    "icon": {
      "type": "string",
      "description": "Emoji representativo",
      "default": "\ud83d\udcb0"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "automation_mode": {
      "type": "string",
      "enum": [
        "manual",
        "auto"
      ],
      "default": "manual",
      "description": "manual = el usuario marca como pagado; auto = el sistema lo registra autom\u00e1ticamente cerca del d\u00eda de vencimiento"
    },
    "autopost_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Habilita el autopost diario para este movimiento (s\u00f3lo si automation_mode='auto')"
    },
    "autopost_day_tolerance": {
      "type": "number",
      "default": 0,
      "description": "D\u00edas de anticipaci\u00f3n tolerados respecto al due_day para hacer el autopost (0-3)"
    },
    "match_hint": {
      "type": "string",
      "description": "Texto auxiliar para conciliaci\u00f3n posterior con extractos bancarios"
    }
  },
  "required": [
    "family_id",
    "name",
    "due_day"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}