{
  "name": "SchemaSnapshot",
  "type": "object",
  "properties": {
    "snapshot_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha en que se tom\u00f3 el snapshot"
    },
    "schema_hash": {
      "type": "string",
      "description": "Hash SHA del contenido serializado para comparaci\u00f3n r\u00e1pida"
    },
    "schema_data": {
      "type": "object",
      "description": "Schemas serializados completos al momento del snapshot",
      "additionalProperties": true
    },
    "is_current": {
      "type": "boolean",
      "default": true,
      "description": "Si es el snapshot activo m\u00e1s reciente"
    },
    "entities_count": {
      "type": "number",
      "description": "N\u00famero de entidades en el snapshot"
    },
    "fields_count": {
      "type": "number",
      "description": "N\u00famero total de campos en el snapshot"
    }
  },
  "required": [
    "snapshot_date",
    "schema_hash",
    "schema_data"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}