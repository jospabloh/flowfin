{
  "name": "RentalProperty",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia propietaria"
    },
    "name": {
      "type": "string",
      "description": "Nombre del inmueble"
    },
    "address": {
      "type": "string"
    },
    "tenant_name": {
      "type": "string",
      "description": "Nombre del inquilino"
    },
    "base_rent": {
      "type": "number",
      "description": "Renta base mensual"
    },
    "payment_day": {
      "type": "number",
      "description": "D\u00eda de pago esperado"
    },
    "concepts": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Conceptos adicionales (mantenimiento, agua, etc.)"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "base_rent"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}