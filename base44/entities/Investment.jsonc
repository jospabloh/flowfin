{
  "name": "Investment",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia propietaria"
    },
    "name": {
      "type": "string",
      "description": "Nombre de la inversi\u00f3n"
    },
    "type": {
      "type": "string",
      "description": "Tipo (inmueble, fondo, etc.)"
    },
    "total_amount": {
      "type": "number",
      "description": "Monto total de la inversi\u00f3n"
    },
    "total_payments": {
      "type": "number",
      "description": "N\u00famero total de pagos/mensualidades"
    },
    "payment_amount": {
      "type": "number",
      "description": "Monto por pago"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio"
    },
    "payment_day": {
      "type": "number",
      "description": "D\u00eda del mes para el pago (1-28)"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "total_amount",
    "total_payments"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    }
  }
}