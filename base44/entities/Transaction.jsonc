{
  "name": "Transaction",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia propietaria"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de la transacción"
    },
    "type": {
      "type": "string",
      "enum": [
        "expense",
        "income"
      ],
      "default": "expense",
      "description": "Tipo: egreso o ingreso"
    },
    "amount": {
      "type": "number",
      "description": "Monto de la transacción"
    },
    "description": {
      "type": "string",
      "description": "Descripción o concepto"
    },
    "category_id": {
      "type": "string",
      "description": "ID de categoría (Rubro)"
    },
    "subcategory_id": {
      "type": "string",
      "description": "ID de subcategoría (SubRubro)"
    },
    "person_id": {
      "type": "string",
      "description": "ID de la persona"
    },
    "payment_method_id": {
      "type": "string",
      "description": "ID del método de pago"
    },
    "required_type": {
      "type": "string",
      "enum": [
        "Necesario",
        "Gusto",
        "Urgente",
        "Inversión",
        "Otro"
      ],
      "default": "Necesario"
    },
    "has_invoice": {
      "type": "boolean",
      "default": false
    },
    "transferred_to": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "week": {
      "type": "number"
    },
    "receipt_image": {
      "type": "string",
      "description": "URL de imagen del ticket/recibo"
    },
    "msi_payment_id": {
      "type": "string"
    },
    "investment_payment_id": {
      "type": "string"
    },
    "scheduled_payment_record_id": {
      "type": "string"
    },
    "rental_payment_id": {
      "type": "string"
    },
    "trip_id": {
      "type": "string",
      "description": "ID of the trip this expense belongs to"
    },
    "original_currency": {
      "type": "string",
      "description": "Currency in which expense was recorded (e.g. USD, EUR)"
    },
    "original_amount": {
      "type": "number",
      "description": "Amount in original currency before conversion"
    },
    "exchange_rate": {
      "type": "number",
      "description": "Exchange rate applied at moment of registration"
    },
    "is_split": {
      "type": "boolean",
      "default": false,
      "description": "Whether this expense was split between trip participants"
    },
    "split_with_person_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Person IDs this expense was split with"
    }
  },
  "required": [
    "date",
    "type",
    "amount",
    "family_id",
    "category_id",
    "person_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    }
  }
}
