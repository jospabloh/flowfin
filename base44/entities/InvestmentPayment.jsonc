{
  "name": "InvestmentPayment",
  "type": "object",
  "properties": {
    "investment_id": {
      "type": "string"
    },
    "family_id": {
      "type": "string",
      "description": "ID de la familia propietaria (denormalizado desde el Investment padre para RLS y filtrado)"
    },
    "payment_number": {
      "type": "number"
    },
    "amount": {
      "type": "number"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "investment_id",
    "payment_number",
    "amount",
    "date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}