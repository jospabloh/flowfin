{
  "name": "Person",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia propietaria"
    },
    "name": {
      "type": "string",
      "description": "Nombre de la persona"
    },
    "color": {
      "type": "string",
      "default": "#059669",
      "description": "Color de identificaci\u00f3n"
    },
    "avatar_initial": {
      "type": "string",
      "description": "Inicial para el avatar"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    }
  }
}