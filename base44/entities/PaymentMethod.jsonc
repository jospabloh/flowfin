{
  "name": "PaymentMethod",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia propietaria"
    },
    "name": {
      "type": "string",
      "description": "Nombre descriptivo (ej: TDC BBVA Azul)"
    },
    "type": {
      "type": "string",
      "enum": [
        "debit",
        "credit",
        "cash",
        "transfer"
      ],
      "default": "cash",
      "description": "Tipo de método de pago"
    },
    "bank": {
      "type": "string",
      "description": "Banco o institución"
    },
    "identifier": {
      "type": "string",
      "description": "Últimos 4 dígitos u otro identificador"
    },
    "cut_day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31,
      "description": "Día del mes en que cierra el ciclo de facturación (fecha de corte)"
    },
    "payment_day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31,
      "description": "Día del mes en que vence el pago (fecha límite de pago)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    }
  }
}
