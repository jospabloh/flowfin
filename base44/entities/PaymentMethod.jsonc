{
  "name": "PaymentMethod",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia propietaria"
    },
    "name": {
      "type": "string",
      "description": "Nombre descriptivo (ej: TDC BBVA Azul)"
    },
    "type": {
      "type": "string",
      "enum": [
        "debit",
        "credit",
        "cash",
        "transfer"
      ],
      "default": "cash",
      "description": "Tipo de m\u00e9todo de pago"
    },
    "bank": {
      "type": "string",
      "description": "Banco o instituci\u00f3n"
    },
    "identifier": {
      "type": "string",
      "description": "\u00daltimos 4 d\u00edgitos u otro identificador"
    },
    "cut_day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31,
      "description": "D\u00eda del mes en que cierra el ciclo de facturaci\u00f3n (fecha de corte)"
    },
    "payment_day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 31,
      "description": "D\u00eda del mes en que vence el pago (fecha l\u00edmite de pago)"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}