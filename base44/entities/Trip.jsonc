{
  "name": "Trip",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "Family owner ID"
    },
    "name": {
      "type": "string",
      "description": "Trip name"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Trip start date"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Trip end date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed"
      ],
      "default": "active",
      "description": "Trip status"
    },
    "destination_countries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of destination countries"
    },
    "currencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Currencies used in trip (e.g. MXN, USD, EUR)"
    },
    "budget_amount": {
      "type": "number",
      "description": "Total budget for the trip"
    },
    "budget_currency": {
      "type": "string",
      "description": "Currency of the budget"
    },
    "participant_person_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Person IDs participating in the trip"
    },
    "created_by_user_id": {
      "type": "string",
      "description": "User ID who created the trip"
    },
    "closed_at": {
      "type": "string",
      "description": "ISO datetime when trip was closed"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes"
    }
  },
  "required": [
    "family_id",
    "name",
    "start_date",
    "end_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}