{
  "name": "FamilyMembership",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia"
    },
    "user_id": {
      "type": "string",
      "description": "ID del usuario"
    },
    "user_email": {
      "type": "string",
      "description": "Email del usuario"
    },
    "user_name": {
      "type": "string",
      "description": "Nombre del usuario"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "member"
      ],
      "default": "member",
      "description": "Rol dentro de la familia"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Estado de la membres\u00eda"
    },
    "tutorial_state": {
      "type": "object",
      "description": "Estado del tutorial de configuraci\u00f3n para el administrador de esta membres\u00eda",
      "additionalProperties": true,
      "default": {}
    },
    "person_id": {
      "type": "string",
      "description": "ID del Person (integrante) vinculado a este usuario. El admin lo configura para que el asistente IA identifique al usuario."
    },
    "last_active_at": {
      "type": "string",
      "description": "ISO datetime de la \u00faltima vez que el usuario fue activo en la app (throttled, m\u00e1x una vez cada 20 min)"
    },
    "last_trial_reactivation_email_at": {
      "type": "string",
      "description": "ISO datetime del \u00faltimo email de reactivaci\u00f3n de trial enviado a este usuario"
    },
    "trial_reactivation_email_count": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de emails de reactivaci\u00f3n de trial enviados durante el per\u00edodo de prueba actual"
    },
    "invited_by_user_id": {
      "type": "string",
      "description": "ID del usuario que envi\u00f3 el deep-link de invitaci\u00f3n que origin\u00f3 esta membres\u00eda. Vac\u00edo para admins (creadores de la familia) o miembros que se unieron sin link de referido."
    }
  },
  "required": [
    "family_id",
    "user_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.family_id": "{{user.data.admin_family_ids}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.family_id": "{{user.data.admin_family_ids}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    }
  }
}