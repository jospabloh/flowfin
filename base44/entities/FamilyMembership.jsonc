{
  "name": "FamilyMembership",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "BLOQUEO (escritura, M\u00f3dulo 14, 2026-09-30): s\u00f3lo servicio. Si se quita, un usuario reasigna su propia membres\u00eda a otra familia por SDK directo. Lo escriben selfJoin/createFamily/approveMember (asServiceRole). | ID de la familia",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "user_id": {
      "type": "string",
      "description": "BLOQUEO (escritura, 2026-09-30): s\u00f3lo servicio. Si se quita, un usuario re-apunta la membres\u00eda a otra persona. | ID del usuario",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "user_email": {
      "type": "string",
      "description": "BLOQUEO (escritura, 2026-09-30): s\u00f3lo servicio. Si se quita, se falsifica a qui\u00e9n pertenece la membres\u00eda. | Email del usuario",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "user_name": {
      "type": "string",
      "description": "Nombre del usuario"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "member"
      ],
      "default": "member",
      "description": "BLOQUEO (escritura, 2026-09-30): s\u00f3lo servicio. Si se quita, cualquier miembro (o solicitante pendiente) se pone admin de su familia por SDK directo. El rol lo fija createFamily (admin) o approveMember (lista blanca member|admin). | Rol dentro de la familia",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "BLOQUEO (escritura, 2026-09-30): s\u00f3lo servicio. Si se quita, un solicitante pendiente se auto-aprueba por SDK directo y salta la aprobaci\u00f3n del admin. Lo escriben selfJoin (pending), approveMember (approved) y rejectMember (rejected). | Estado de la membres\u00eda",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "tutorial_state": {
      "type": "object",
      "additionalProperties": true,
      "default": {},
      "description": "Estado del tutorial de configuraci\u00f3n para el administrador de esta membres\u00eda"
    },
    "person_id": {
      "type": "string",
      "description": "ID del Person (integrante) vinculado a este usuario."
    },
    "last_active_at": {
      "type": "string",
      "description": "ISO datetime de la \u00faltima vez que el usuario fue activo en la app"
    },
    "last_trial_reactivation_email_at": {
      "type": "string",
      "description": "ISO datetime del \u00faltimo email de reactivaci\u00f3n de trial enviado a este usuario"
    },
    "trial_reactivation_email_count": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de emails de reactivaci\u00f3n de trial enviados durante el per\u00edodo de prueba actual"
    },
    "invited_by_user_id": {
      "type": "string",
      "description": "ID del usuario que envi\u00f3 el deep-link de invitaci\u00f3n que origin\u00f3 esta membres\u00eda."
    }
  },
  "required": [
    "family_id",
    "user_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}
