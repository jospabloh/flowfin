{
  "name": "FamilyMembership",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia"
    },
    "user_id": {
      "type": "string",
      "description": "ID del usuario"
    },
    "user_email": {
      "type": "string",
      "description": "Email del usuario"
    },
    "user_name": {
      "type": "string",
      "description": "Nombre del usuario"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "member"
      ],
      "default": "member",
      "description": "Rol dentro de la familia"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Estado de la membres\u00eda"
    },
    "person_id": {
      "type": "string",
      "description": "ID del Person (integrante) vinculado a este usuario. El admin lo configura para que el asistente IA identifique al usuario."
    },
    "tutorial_state": {
      "type": "object",
      "description": "Estado del tutorial de configuraci\u00f3n para el administrador de esta membres\u00eda",
      "additionalProperties": true,
      "default": {}
    }
  },
  "required": [
    "family_id",
    "user_id",
    "user_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.family_id": "{{user.data.admin_family_ids}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.family_id": "{{user.data.admin_family_ids}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    }
  }
}