{
  "name": "MSIPayment",
  "type": "object",
  "properties": {
    "msi_id": {
      "type": "string"
    },
    "family_id": {
      "type": "string",
      "description": "ID de la familia propietaria (denormalizado desde el MSI padre para RLS y filtrado por familia)"
    },
    "month_number": {
      "type": "number"
    },
    "amount": {
      "type": "number"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "msi_id",
    "month_number",
    "amount",
    "paid_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}