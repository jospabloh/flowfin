{
  "name": "MSIPayment",
  "type": "object",
  "properties": {
    "msi_id": {
      "type": "string"
    },
    "family_id": {
      "type": "string",
      "description": "ID de la familia propietaria (denormalizado desde el MSI padre para RLS y filtrado)"
    },
    "month_number": {
      "type": "number"
    },
    "amount": {
      "type": "number"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "msi_id",
    "month_number",
    "amount",
    "paid_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}