{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "preferences": {
      "type": "object",
      "description": "Preferencias personales del usuario (UI, filtros, etc.)",
      "additionalProperties": true
    },
    "family_id": {
      "type": "string",
      "description": "ID de la familia (tenant) a la que pertenece el usuario. Sólo se escribe desde funciones de servidor vía asServiceRole (selfJoin, approveMember, createFamily, removeMember, setUserFamilyId, fixUserFamilyId/fixUserData, switchFamily) — esas escrituras evaden RLS por diseño. RESTORED 2026-08-25: this field-level rls.write lock (added 2026-08-23, module 14 finding #1) was incorrectly removed by an independent agent session that misdiagnosed a user-facing 'stuck on Onboarding' symptom as caused by this WRITE lock. A write lock cannot affect a READ outcome -- RLS write and read rules are independent; stripping the write lock could not have fixed (and did not fix) the reported symptom, but it did reopen the exact self-service tenant-hop hole this lock exists to close (any authenticated user could set their own family_id to any value via a direct client update and read that family's data via Family/Transaction/etc.'s own family_id-keyed RLS). Restored the lock; the setUserFamilyId server-side membership guard added in the same incident is complementary defense-in-depth and was left in place.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "role"
  ],
  "rls": {
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "id": "{{user.id}}"
        }
      ]
    }
  }
}
