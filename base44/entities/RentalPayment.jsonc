{
  "name": "RentalPayment",
  "type": "object",
  "properties": {
    "property_id": {
      "type": "string"
    },
    "family_id": {
      "type": "string",
      "description": "ID de la familia propietaria \u2014 para filtros y RLS"
    },
    "month": {
      "type": "string",
      "description": "Mes en formato YYYY-MM"
    },
    "amount": {
      "type": "number"
    },
    "paid_by": {
      "type": "string"
    },
    "deposit_account": {
      "type": "string"
    },
    "date_paid": {
      "type": "string",
      "format": "date"
    },
    "is_paid": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    },
    "payment_method_id": {
      "type": "string",
      "description": "ID del m\u00e9todo de pago usado"
    }
  },
  "required": [
    "property_id",
    "month",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    }
  }
}