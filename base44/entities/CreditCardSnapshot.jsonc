{
  "name": "CreditCardSnapshot",
  "type": "object",
  "properties": {
    "family_id": {
      "description": "Family owner ID",
      "type": "string"
    },
    "payment_method_id": {
      "description": "Credit card payment method ID",
      "type": "string"
    },
    "balance": {
      "description": "Saldo total adeudado en la tarjeta",
      "type": "number"
    },
    "amount_due": {
      "description": "Monto que el banco indica pagar en este ciclo de corte",
      "type": "number"
    },
    "snapshot_date": {
      "description": "Date of this balance snapshot",
      "format": "date",
      "type": "string"
    },
    "notes": {
      "description": "Optional notes",
      "type": "string"
    }
  },
  "required": [
    "family_id",
    "payment_method_id",
    "balance",
    "snapshot_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}