{
  "name": "CreditCardSnapshot",
  "type": "object",
  "properties": {
    "family_id": {
      "description": "Family owner ID",
      "type": "string"
    },
    "payment_method_id": {
      "description": "Credit card payment method ID",
      "type": "string"
    },
    "balance": {
      "description": "Saldo total adeudado en la tarjeta",
      "type": "number"
    },
    "amount_due": {
      "description": "Monto que el banco indica pagar en este ciclo de corte",
      "type": "number"
    },
    "snapshot_date": {
      "description": "Date of this balance snapshot",
      "format": "date",
      "type": "string"
    },
    "notes": {
      "description": "Optional notes",
      "type": "string"
    }
  },
  "required": [
    "family_id",
    "payment_method_id",
    "balance",
    "snapshot_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    }
  }
}