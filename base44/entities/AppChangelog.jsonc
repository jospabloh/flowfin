{
  "name": "AppChangelog",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Versi\u00f3n semver (ej. 1.0.1)"
    },
    "release_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de lanzamiento"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de cambios en esta versi\u00f3n"
    },
    "is_current": {
      "type": "boolean",
      "default": false,
      "description": "Si es la versi\u00f3n activa actualmente"
    }
  },
  "required": [
    "version",
    "release_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}