{
  "name": "EmailNotification",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia asociada"
    },
    "email_type": {
      "type": "string",
      "description": "Tipo de email: trial_welcome, trial_day20, trial_day27, trial_day29, trial_ended, archived_warning, deletion_warning, license_expiry_10d, license_expiry_5d, license_expiry_1d, license_expired, grace_period_warning, license_view_only, license_archived, license_deletion_warning, renewal_upcoming, renewal_confirmed"
    },
    "recipient_email": {
      "type": "string",
      "description": "Correo del destinatario"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "sent",
        "failed"
      ],
      "default": "pending",
      "description": "Estado del env\u00edo"
    },
    "retry_count": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de intentos de reenv\u00edo"
    },
    "sent_at": {
      "type": "string",
      "description": "ISO datetime cuando fue enviado exitosamente"
    },
    "last_attempt_at": {
      "type": "string",
      "description": "ISO datetime del \u00faltimo intento"
    },
    "error_message": {
      "type": "string",
      "description": "Mensaje de error del \u00faltimo intento fallido"
    }
  },
  "required": [
    "family_id",
    "email_type",
    "recipient_email",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}