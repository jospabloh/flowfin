{
  "name": "ChangelogDraft",
  "properties": {
    "description": {
      "description": "Descripci\u00f3n del cambio escrita por el developer",
      "type": "string"
    },
    "is_published": {
      "default": false,
      "description": "Si ya fue incluido en un AppChangelog publicado",
      "type": "boolean"
    },
    "published_at": {
      "description": "ISO datetime cuando fue publicado",
      "type": "string"
    },
    "published_in_version": {
      "description": "Versi\u00f3n en la que fue publicado (ej. 1.0.2)",
      "type": "string"
    },
    "type": {
      "description": "Tipo de cambio",
      "enum": [
        "fix",
        "feature",
        "security",
        "system",
        "breaking"
      ],
      "type": "string"
    }
  },
  "required": [
    "description",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}