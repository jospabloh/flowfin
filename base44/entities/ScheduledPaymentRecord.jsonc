{
  "name": "ScheduledPaymentRecord",
  "type": "object",
  "properties": {
    "scheduled_payment_id": {
      "type": "string",
      "description": "ID del pago programado"
    },
    "family_id": {
      "type": "string",
      "description": "ID de la familia"
    },
    "month": {
      "type": "string",
      "description": "Mes en formato YYYY-MM"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha real del pago"
    },
    "amount_paid": {
      "type": "number",
      "description": "Monto real pagado"
    },
    "notes": {
      "type": "string"
    },
    "paid_by": {
      "type": "string",
      "description": "Nombre o email de quien marc\u00f3 el pago"
    }
  },
  "required": [
    "scheduled_payment_id",
    "family_id",
    "month"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}