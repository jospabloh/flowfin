{
  "name": "ScheduledPaymentRecord",
  "type": "object",
  "properties": {
    "scheduled_payment_id": {
      "type": "string",
      "description": "ID del pago programado"
    },
    "family_id": {
      "type": "string",
      "description": "ID de la familia"
    },
    "month": {
      "type": "string",
      "description": "Mes en formato YYYY-MM"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha real del pago"
    },
    "amount_paid": {
      "type": "number",
      "description": "Monto real pagado"
    },
    "notes": {
      "type": "string"
    },
    "paid_by": {
      "type": "string",
      "description": "Nombre o email de quien marcó el pago"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "reconciled"
      ],
      "default": "reconciled",
      "description": "Estado de conciliación del registro"
    },
    "origin": {
      "type": "string",
      "enum": [
        "manual",
        "converted",
        "auto"
      ],
      "description": "Quién creó el registro: manual (Pagos del Mes), converted (Convertir en domiciliado) o auto (autopost)"
    },
    "linked_transaction_id": {
      "type": "string",
      "description": "ID del movimiento ya vinculado a este registro. Si viene poblado, la automatización NO debe crear otro"
    }
  },
  "required": [
    "scheduled_payment_id",
    "family_id",
    "month"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    }
  }
}
