{
  "name": "Goal",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia propietaria"
    },
    "name": {
      "type": "string",
      "description": "Nombre de la meta financiera"
    },
    "description": {
      "type": "string",
      "description": "Descripción opcional de la meta"
    },
    "target_amount": {
      "type": "number",
      "description": "Monto objetivo a alcanzar"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "description": "Fecha límite para alcanzar la meta"
    },
    "icon": {
      "type": "string",
      "description": "Emoji representativo",
      "default": "🎯"
    },
    "color": {
      "type": "string",
      "description": "Color hex para identificación visual",
      "default": "#059669"
    },
    "category_id": {
      "type": "string",
      "description": "Categoría de transacciones vinculada a esta meta (opcional)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Si la meta está activa"
    },
    "manual_saved": {
      "type": "number",
      "default": 0,
      "description": "Monto guardado manualmente (además del calculado automáticamente)"
    }
  },
  "required": [
    "family_id",
    "name",
    "target_amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    }
  }
}
