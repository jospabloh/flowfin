{
  "name": "Goal",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia propietaria"
    },
    "name": {
      "type": "string",
      "description": "Nombre de la meta financiera"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n opcional de la meta"
    },
    "target_amount": {
      "type": "number",
      "description": "Monto objetivo a alcanzar"
    },
    "deadline": {
      "type": "string",
      "format": "date",
      "description": "Fecha l\u00edmite para alcanzar la meta"
    },
    "icon": {
      "type": "string",
      "description": "Emoji representativo",
      "default": "\ud83c\udfaf"
    },
    "color": {
      "type": "string",
      "description": "Color hex para identificaci\u00f3n visual",
      "default": "#059669"
    },
    "category_id": {
      "type": "string",
      "description": "Categor\u00eda de transacciones vinculada a esta meta (opcional)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Si la meta est\u00e1 activa"
    },
    "manual_saved": {
      "type": "number",
      "default": 0,
      "description": "Monto guardado manualmente (adem\u00e1s del calculado autom\u00e1ticamente)"
    }
  },
  "required": [
    "family_id",
    "name",
    "target_amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}