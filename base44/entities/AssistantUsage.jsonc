{
  "indexes": [
    [
      "family_id",
      "created_at"
    ]
  ],
  "name": "AssistantUsage",
  "properties": {
    "cache_read": {
      "default": 0,
      "description": "Tokens le\u00eddos desde cach\u00e9 (cache_read_input_tokens)",
      "type": "number"
    },
    "cost_usd": {
      "description": "Costo estimado en USD (6 decimales)",
      "type": "number"
    },
    "created_at": {
      "description": "Timestamp de la operaci\u00f3n (ISO 8601)",
      "format": "date-time",
      "type": "string"
    },
    "family_id": {
      "description": "ID de la familia propietaria",
      "type": "string"
    },
    "latency_ms": {
      "description": "Latencia de la llamada al API en milisegundos",
      "type": "number"
    },
    "model": {
      "description": "Nombre del modelo de IA utilizado (ej: claude-haiku-4-5)",
      "type": "string"
    },
    "operation": {
      "default": "receipt_scan",
      "description": "Tipo de operaci\u00f3n de IA",
      "enum": [
        "receipt_scan",
        "chat_reply"
      ],
      "type": "string"
    },
    "person_id": {
      "description": "ID de la persona que realiz\u00f3 el escaneo (nullable)",
      "type": "string"
    },
    "tokens_in": {
      "description": "Tokens de entrada consumidos",
      "type": "number"
    },
    "tokens_out": {
      "description": "Tokens de salida generados",
      "type": "number"
    }
  },
  "required": [
    "family_id",
    "operation",
    "created_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}