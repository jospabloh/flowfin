{
  "name": "AssistantUsage",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia propietaria"
    },
    "person_id": {
      "type": "string",
      "description": "ID de la persona que realizó el escaneo (nullable)"
    },
    "operation": {
      "type": "string",
      "enum": ["receipt_scan", "chat_reply"],
      "default": "receipt_scan",
      "description": "Tipo de operación de IA"
    },
    "model": {
      "type": "string",
      "description": "Nombre del modelo de IA utilizado (ej: claude-haiku-4-5)"
    },
    "tokens_in": {
      "type": "number",
      "description": "Tokens de entrada consumidos"
    },
    "tokens_out": {
      "type": "number",
      "description": "Tokens de salida generados"
    },
    "cache_read": {
      "type": "number",
      "default": 0,
      "description": "Tokens leídos desde caché (cache_read_input_tokens)"
    },
    "cost_usd": {
      "type": "number",
      "description": "Costo estimado en USD (6 decimales)"
    },
    "latency_ms": {
      "type": "number",
      "description": "Latencia de la llamada al API en milisegundos"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de la operación (ISO 8601)"
    }
  },
  "required": [
    "family_id",
    "operation",
    "created_at"
  ],
  "indexes": [
    ["family_id", "created_at"]
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        },
        {
          "data.family_id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
