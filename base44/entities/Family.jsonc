{
  "name": "Family",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la familia"
    },
    "join_code": {
      "type": "string",
      "description": "Código único para unirse a la familia (ej: GARCIA24)"
    },
    "admin_user_id": {
      "type": "string",
      "description": "ID del usuario administrador de la familia"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "currency": {
      "type": "string",
      "default": "MXN"
    },
    "currency_symbol": {
      "type": "string",
      "default": "$"
    },
    "trial_start_at": {
      "type": "string",
      "description": "Fecha de inicio del período de prueba (ISO datetime, servidor)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "trial_end_at": {
      "type": "string",
      "description": "Fecha de fin del período de prueba (ISO datetime, servidor)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "billing_status": {
      "type": "string",
      "enum": [
        "trial",
        "active",
        "view_only",
        "suspended"
      ],
      "default": "trial",
      "description": "Estado comercial de la familia: trial, active, view_only, suspended",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "license_plan": {
      "type": "string",
      "enum": [
        "home",
        "family_plus",
        "circle"
      ],
      "default": "home",
      "description": "Plan de licencia: home (4), family_plus (10), circle (20)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "licensed_member_limit": {
      "type": "number",
      "default": 4,
      "description": "Número máximo de integrantes permitidos según el plan",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "license_activated_at": {
      "type": "string",
      "description": "Fecha en que se activó la licencia (ISO datetime)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "license_expires_at": {
      "type": "string",
      "description": "Fecha de vencimiento de la licencia (ISO datetime, null si no aplica)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "payment_reference": {
      "type": "string",
      "description": "Referencia de pago del cliente (folio, transacción, etc.)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "activation_notes": {
      "type": "string",
      "description": "Notas internas de activación (uso ACACIA)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "activated_by_admin": {
      "type": "string",
      "description": "Email del administrador ACACIA que activó la licencia",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "support_contacted_at": {
      "type": "string",
      "description": "Última vez que el cliente contactó soporte (ISO datetime)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "auto_renewal": {
      "type": "boolean",
      "default": false,
      "description": "Indica si la familia tiene suscripción Mercado Pago activa (cobro externo, validación manual por ACACIA)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "last_payment_confirmed_at": {
      "type": "string",
      "description": "ISO datetime cuando ACACIA confirmó el último pago dentro de FlowFin",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "last_payment_confirmed_by": {
      "type": "string",
      "description": "Email del admin de plataforma que confirmó el último pago",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "last_payment_period": {
      "type": "string",
      "description": "Período de facturación confirmado por ACACIA, formato YYYY-MM",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "last_payment_reference": {
      "type": "string",
      "description": "Referencia del último pago confirmado (Mercado Pago ID, folio, nota manual)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "last_payment_notes": {
      "type": "string",
      "description": "Notas internas ACACIA del último pago confirmado",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "default_person_id": {
      "type": "string",
      "description": "ID del Person creado por defecto para el admin al crear la familia. Permite a QuickCapture inferir person_id sin forzar setup adicional. Las familias creadas antes de 2026-05-20 pueden no tenerlo; usar backfillDefaultPerson o el fallback del frontend."
    }
  },
  "required": [
    "name",
    "join_code",
    "admin_user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.admin_user_id": "{{user.id}}"
        },
        {
          "id": "{{user.data.family_id}}"
        },
        {
          "id": "{{user.data.data.family_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.admin_user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
