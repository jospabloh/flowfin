{
  "name": "PaymentEvent",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "description": "Pasarela origen del evento (mercadopago, manual, etc)"
    },
    "provider_event_id": {
      "type": "string",
      "description": "ID propio del proveedor (e.g. payment id de MP). Usado para idempotencia."
    },
    "event_type": {
      "type": "string",
      "description": "Tipo del evento: payment.created | payment.updated | subscription.authorized_payment | manual.confirmed | other"
    },
    "status": {
      "type": "string",
      "description": "Estado del pago al momento del evento (approved | pending | rejected | refunded | other)"
    },
    "amount": {
      "type": "number",
      "description": "Monto en MXN reportado por el proveedor"
    },
    "currency": { "type": "string", "default": "MXN", "description": "Moneda reportada" },
    "external_reference": {
      "type": "string",
      "description": "external_reference enviado a MP al crear la preferencia. Formato: family_id:plan:period"
    },
    "family_id": {
      "type": "string",
      "description": "Familia derivada de external_reference (best-effort)"
    },
    "raw_payload_json": {
      "type": "object",
      "additionalProperties": true,
      "description": "Payload completo recibido del proveedor. Para auditoría y reprocessing."
    },
    "signature_valid": {
      "type": "boolean",
      "default": false,
      "description": "Si la firma del webhook fue verificada correctamente."
    },
    "processed_at": {
      "type": "string",
      "description": "ISO datetime cuando se invocó confirmLicensePayment (vacío si no se procesó)"
    },
    "processed_outcome": {
      "type": "string",
      "description": "ok | skipped | error — resultado del processing"
    },
    "processed_notes": {
      "type": "string",
      "description": "Mensaje libre con razón del outcome"
    }
  },
  "required": ["provider", "provider_event_id", "event_type"],
  "rls": {
    "create": { "user_condition": { "role": "admin" } },
    "read": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}
