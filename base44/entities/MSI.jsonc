{
  "name": "MSI",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia propietaria"
    },
    "store": {
      "type": "string",
      "description": "Tienda o comercio"
    },
    "concept": {
      "type": "string",
      "description": "Descripción de la compra"
    },
    "total_amount": {
      "type": "number",
      "description": "Monto total original"
    },
    "monthly_amount": {
      "type": "number",
      "description": "Mensualidad"
    },
    "total_months": {
      "type": "number",
      "description": "Total de meses"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio"
    },
    "billing_day": {
      "type": "number",
      "description": "Día de cobro mensual"
    },
    "notes": {
      "type": "string"
    },
    "category_id": {
      "type": "string",
      "description": "Rubro al que se cargan las mensualidades"
    },
    "payment_method_id": {
      "type": "string",
      "description": "Forma de pago con la que se liquidan las mensualidades"
    },
    "person_id": {
      "type": "string",
      "description": "Persona responsable del MSI"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "store",
    "total_amount",
    "monthly_amount",
    "total_months",
    "start_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.family_id": "{{user.data.family_id}}"
        }
      ]
    }
  }
}
