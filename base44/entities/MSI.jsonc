{
  "name": "MSI",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia propietaria"
    },
    "store": {
      "type": "string",
      "description": "Tienda o comercio"
    },
    "concept": {
      "type": "string",
      "description": "Descripci\u00f3n de la compra"
    },
    "total_amount": {
      "type": "number",
      "description": "Monto total original"
    },
    "monthly_amount": {
      "type": "number",
      "description": "Mensualidad"
    },
    "total_months": {
      "type": "number",
      "description": "Total de meses"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio"
    },
    "billing_day": {
      "type": "number",
      "description": "D\u00eda de cobro mensual"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "store",
    "total_amount",
    "monthly_amount",
    "total_months",
    "start_date"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}