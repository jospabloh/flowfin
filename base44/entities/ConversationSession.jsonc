{
  "name": "ConversationSession",
  "type": "object",
  "properties": {
    "family_id": {
      "type": "string",
      "description": "ID de la familia propietaria"
    },
    "user_id": {
      "type": "string",
      "description": "ID del usuario que inici\u00f3 la sesi\u00f3n"
    },
    "conversation_id": {
      "type": "string",
      "description": "ID de la conversaci\u00f3n en el agente"
    },
    "channel": {
      "type": "string",
      "enum": [
        "web",
        "whatsapp"
      ],
      "default": "web",
      "description": "Canal de comunicaci\u00f3n de la sesi\u00f3n"
    },
    "session_date": {
      "type": "string",
      "description": "Fecha de la sesi\u00f3n (YYYY-MM-DD)"
    },
    "messages": {
      "type": "array",
      "description": "Mensajes de la conversaci\u00f3n archivados"
    },
    "summary": {
      "type": "string",
      "description": "Resumen breve de la sesi\u00f3n"
    },
    "message_count": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero total de mensajes en la sesi\u00f3n"
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de cuando se archiv\u00f3 la sesi\u00f3n (ISO 8601)"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de expiraci\u00f3n del registro (ISO 8601)"
    }
  },
  "required": [
    "family_id",
    "user_id",
    "conversation_id",
    "session_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.user_id": "{{user.id}}"
        }
      ]
    }
  }
}